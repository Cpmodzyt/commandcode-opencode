[Unit]
Description=Command Code -> OpenAI-compatible proxy (for OpenCode)
Documentation=https://github.com/Cpmodzyt/commandcode-opencode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PREFIX@
Environment=PORT=@PORT@
Environment=COMMAND_CODE_TOKEN_FILE=@PREFIX@/token
ExecStart=/usr/bin/env node @PREFIX@/proxy.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
